{
  "name": "cantieri-upload-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo mobile per foto e video in Microsoft Fabric OneLake.",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "npm run build && tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-public.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && tsx --test tests/browser.spec.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@azure/msal-node": "7.0.0",
    "@azure/storage-file-datalake": "12.31.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "memorystore": "1.6.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.13.5",
    "@types/supertest": "7.2.1",
    "playwright": "1.63.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
